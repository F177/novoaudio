  {
    "start": 336.103,
    "end": 336.283,
    "text": "Oh!"
  },
  {
    "start": 336.583,
    "end": 337.784,
    "text": "He broke his ankles."
  },
  {
    "start": 338.084,
    "end": 339.346,
    "text": "Now he's got an entourage."
  },
  {
    "start": 339.786,
    "end": 341.267,
    "text": "And he's got a touchdown."
  },
  {
    "start": 342.495,
    "end": 343.776,
    "text": "He is Houdini."
