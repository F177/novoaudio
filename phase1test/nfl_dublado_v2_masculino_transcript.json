    "text": "DeAndre Hopkins."
  },
  {
    "start": 206.875,
    "end": 207.935,
    "text": "Miraculous."
  },
  {
    "start": 208.376,
    "end": 209.436,
    "text": "Tadavious White."
  },
  {
    "start": 210.617,
    "end": 212.018,
    "text": "Jordan Poyer came in late."
  },
  {
    "start": 212.038,
    "end": 213.8,
    "text": "He's got Micah Hyde on his back."
  },
  {
    "start": 214.716,
    "end": 217.798,
    "text": "And catches it and possesses it all the way through."
  },
  {
    "start": 217.838,
    "end": 218.799,
    "text": "Look at those hands."
  },
  {
    "start": 219.199,
    "end": 224.042,
    "text": "We keep hearing about those 6X gloves that he wears for his large hands."
  },
  {
    "start": 224.182,
    "end": 225.323,
    "text": "I look like a psycho."
  },
  {
    "start": 225.643,
    "end": 227.184,
    "text": "I'm just going to keep my helmet on for the rest of the game."
  },
  {
    "start": 227.204,
    "end": 229.806,
    "text": "Yeah, I'm the smart guy with the headbutt, someone with no helmet on."
