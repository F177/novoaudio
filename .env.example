# Supabase (Postgres + Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare R2 (storage de mídia, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# RunPod (GPU serverless — um endpoint por worker, ver /runpod)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_SEPARATE_STEMS=
RUNPOD_ENDPOINT_TRANSCRIBE=
RUNPOD_ENDPOINT_SYNTHESIZE=
RUNPOD_ENDPOINT_EVALUATE=

# Hugging Face (necessário para o pyannote de diarização, modelo com licença)
HF_TOKEN=

# Anthropic (tradução com restrição de comprimento)
ANTHROPIC_API_KEY=

# Asaas (pagamento — PIX e boleto)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Sentry
SENTRY_DSN=

# App
ENVIRONMENT=development
