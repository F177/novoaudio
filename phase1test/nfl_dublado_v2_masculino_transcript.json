    "text": "He's dancing his way."
  },
  {
    "start": 318.487,
    "end": 319.448,
    "text": "For the touchdown!"
  },
  {
    "start": 319.808,
    "end": 321.61,
    "text": "He breaks the tackle of Shanley."
  },
  {
    "start": 321.93,
    "end": 323.191,
    "text": "Runs through Sharper."
  },
  {
    "start": 323.532,
    "end": 324.753,
    "text": "Runs through Adele."
  },
  {
    "start": 325.133,
    "end": 326.714,
    "text": "Runs through Jabari Greer."
  },
  {
    "start": 327.035,
    "end": 330.378,
    "text": "Get off me, he says to Tracy Porter."
  },
  {
    "start": 330.398,
    "end": 332.68,
    "text": "It's a second down and three."
  },
  {
    "start": 332.78,
    "end": 334.061,
    "text": "Jackson takes it himself."
  },
  {
    "start": 334.101,
    "end": 335.722,
    "text": "Look at him dart back and forth."
