# Supabase (Postgres + Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare R2 (storage de mídia, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# RunPod (GPU serverless — um endpoint por worker, ver /runpod)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_SEPARATE_STEMS=
RUNPOD_ENDPOINT_TRANSCRIBE=
RUNPOD_ENDPOINT_TRANSLATE=
RUNPOD_ENDPOINT_SYNTHESIZE=
RUNPOD_ENDPOINT_EVALUATE=

# Hugging Face (necessário para o pyannote de diarização, modelo com licença)
HF_TOKEN=

# RunPod Pod comum (SSH, sem Docker) — usado por scripts/dub.py (T0.12) pra
# validar o pipeline de ponta a ponta antes de depender do serverless acima.
POD_HOST=
POD_PORT=
POD_USER=root
POD_SSH_KEY_PATH=
POD_WORKSPACE=
# Opcionais — caminho do python de cada venv já preparado no Pod (ver
# scripts/pod_runner.py). Default assume /root/venvs/{asr,tts}/bin/python.
POD_PYTHON_ASR=
POD_PYTHON_TTS=
# Opcional — libcudnn do faster-whisper não é achada sem isso (ver pod_runner.py).
POD_LD_LIBRARY_PATH_ASR=
# Opcional — caminho (no Pod) da voz de referência fixa pra síntese.
POD_VOICE_REFERENCE=
# Opcional — caminho absoluto (no Pod) de um adapter LoRA treinado pra
# fundir no MOSS-TTS antes de sintetizar. Vazio = sem fine-tuning.
POD_LORA_ADAPTER_PATH=
# Opcional (default "cuda") — em GPUs de ~23GB o MOSS-TTS base já quase
# enche a VRAM sozinho; "cpu" faz o audio_tokenizer caber, mas deixa a
# síntese mais lenta (ver pod_runner.py e pod_worker.py::cmd_synthesize).
POD_AUDIO_TOKENIZER_DEVICE=

# Asaas (pagamento — PIX e boleto)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Sentry
SENTRY_DSN=

# App
ENVIRONMENT=development
